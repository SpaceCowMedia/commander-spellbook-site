{
  "name": "spellbook-client-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "pnpm": ">=10.16.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "build:test": "cross-env NODE_ENV=test next build",
    "start:test": "cross-env NODE_ENV=test next start",
    "lint": "eslint . && stylelint '**/*.{css,scss,vue}' && prettier --check .",
    "tsc": "tsc",
    "cy:run": "cypress run",
    "cy:open": "cypress open",
    "cy:debug": "concurrently --kill-others -n next,cypress -s command-cypress \"pnpm dev\" \"wait-on http://localhost:3000 && pnpm cy:open\"",
    "cy:dev": "pnpm build:test && concurrently --kill-others -n next,cypress -s command-cypress \"pnpm start:test\" \"wait-on http://localhost:3000 && pnpm cy:open\"",
    "prettier": "prettier --write .",
    "test:integration": "pnpm build:test && concurrently --kill-others -n next,cypress -s command-cypress \"pnpm start:test\" \"wait-on http://localhost:3000 && pnpm cy:run\"",
    "clean:cache": "node -e \"for (const p of ['.next/cache', '.next/dev', 'node_modules/.cache', 'tsconfig.tsbuildinfo', '.eslintcache', '.stylelintcache']) require('node:fs').rmSync(p, { recursive: true, force: true })\" && cypress cache clear && pnpm store prune",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint",
    "*.{css,scss,vue}": [
      "stylelint",
      "prettier --check"
    ]
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@space-cow-media/spellbook-client": "^6.2.6",
    "canvas": "^3.2.3",
    "cookies-next": "^6.1.1",
    "markdown-to-jsx": "^9.10.2",
    "next": "^16.3.2",
    "pluralize": "^8.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-select": "^5.10.2",
    "react-swipeable": "^7.0.2",
    "react-tooltip": "^6.0.8",
    "scryfall-client": "^0.24.8",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.2",
    "@scryfall/api-types": "^1.0.0-alpha.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "cypress": "^15.20.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "wait-on": "^9.1.0"
  }
}
