{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=733558
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Clean caches",
            "detail": "Clears the Next.js, Node tooling, TypeScript, lint, Cypress and pnpm store caches",
            "type": "shell",
            "command": "pnpm clean:cache",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    // VS Code sets this on its own processes, and Cypress cannot start with it inherited.
                    "ELECTRON_RUN_AS_NODE": "",
                },
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
            },
            "problemMatcher": [],
        },
    ]
}
